"""Small status dashboard for the Dogecoin Core Umbrel app (stdlib only)."""

import base64
import json
import os
import time
import urllib.error
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

PORT = int(os.environ.get("PORT", "3000"))
RPC_URL = "http://" + os.environ["RPC_HOST"] + ":" + os.environ["RPC_PORT"] + "/"
RPC_USER = os.environ["RPC_USER"]
RPC_PASS = os.environ["RPC_PASS"]
AUTH = "Basic " + base64.b64encode((RPC_USER + ":" + RPC_PASS).encode()).decode()

CONNECTION = {
    "version": os.environ.get("APP_VERSION", ""),
    "node_host": os.environ.get("NODE_HOST", ""),
    "device": os.environ.get("DEVICE_DOMAIN_NAME", "umbrel.local"),
    "rpc_port": os.environ.get("RPC_PORT", ""),
    "p2p_port": os.environ.get("P2P_PORT", ""),
    "rpc_user": RPC_USER,
    "rpc_pass": RPC_PASS,
    "zmq": {
        "hashblock": os.environ.get("ZMQ_HASHBLOCK_PORT", ""),
        "rawblock": os.environ.get("ZMQ_RAWBLOCK_PORT", ""),
        "rawtx": os.environ.get("ZMQ_RAWTX_PORT", ""),
    },
}

_cache = {"t": 0.0, "data": None}


class RpcError(Exception):
    pass


def rpc(method, params=None):
    body = json.dumps({"jsonrpc": "1.0", "id": "dash", "method": method, "params": params or []}).encode()
    req = urllib.request.Request(RPC_URL, data=body, headers={"Authorization": AUTH, "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            payload = json.loads(resp.read())
    except urllib.error.HTTPError as exc:
        try:
            payload = json.loads(exc.read())
        except Exception:  # noqa: BLE001
            raise RpcError("HTTP " + str(exc.code))
    if payload.get("error"):
        raise RpcError(payload["error"].get("message", "RPC error"))
    return payload["result"]


def status():
    now = time.time()
    if _cache["data"] is not None and now - _cache["t"] < 4:
        return _cache["data"]
    data = {"connection": CONNECTION}
    try:
        chain = rpc("getblockchaininfo")
        net = rpc("getnetworkinfo")
        mempool = rpc("getmempoolinfo")
        peers = rpc("getpeerinfo")
        try:
            uptime = rpc("uptime")
        except RpcError:
            uptime = None  # not available in Dogecoin Core 1.14
        inbound = sum(1 for p in peers if p.get("inbound"))
        progress = float(chain.get("verificationprogress", 0) or 0)
        synced = (not chain.get("initialblockdownload", True)) and chain.get("blocks") == chain.get("headers")
        data.update({
            "state": "synced" if synced else "syncing",
            "chain": chain.get("chain"),
            "blocks": chain.get("blocks"),
            "headers": chain.get("headers"),
            "progress": min(progress, 1.0),
            "size_on_disk": chain.get("size_on_disk"),
            "difficulty": chain.get("difficulty"),
            "subversion": net.get("subversion"),
            "connections": net.get("connections", len(peers)),
            "inbound": inbound,
            "outbound": len(peers) - inbound,
            "mempool_txs": mempool.get("size"),
            "mempool_bytes": mempool.get("bytes"),
            "uptime": uptime,
            "peers": [
                {"addr": p.get("addr"), "subver": p.get("subver"), "inbound": p.get("inbound"), "height": p.get("synced_blocks")}
                for p in peers[:25]
            ],
        })
    except RpcError as exc:
        data.update({"state": "starting", "message": str(exc)})
    except Exception as exc:  # noqa: BLE001
        data.update({"state": "starting", "message": "Waiting for dogecoind (" + exc.__class__.__name__ + ")"})
    _cache.update(t=now, data=data)
    return data


def fmt_int(n):
    return "{:,}".format(n) if isinstance(n, int) else "-"


def widget_stats():
    s = status()
    size = s.get("size_on_disk")
    mempool = s.get("mempool_txs")
    return {
        "type": "four-stats",
        "refresh": "10s",
        "link": "",
        "items": [
            {"title": "Block height", "text": fmt_int(s.get("blocks")), "subtext": ""},
            {"title": "Peers", "text": str(s.get("connections", 0)), "subtext": "connected"},
            {"title": "Mempool", "text": fmt_int(mempool) if mempool is not None else "-", "subtext": "txs"},
            {"title": "Chain size", "text": str(round(size / 1e9)) if size else "-", "subtext": "GB"},
        ],
    }


def widget_sync():
    s = status()
    progress = float(s.get("progress", 0) or 0)
    state = s.get("state")
    label = {"synced": "Synced", "syncing": "In progress"}.get(state, "Starting")
    return {
        "type": "text-with-progress",
        "refresh": "10s",
        "link": "",
        "title": "Blockchain sync",
        "text": str(int(progress * 1000) / 10.0) + "%",
        "progressLabel": label,
        "progress": progress,
    }


